{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jovicgroup",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-15",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://zorylsswdzsjxsyrevec.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_9QP8CpgZSau8yNM8vyVzpw_BOLCyqhO",
    "ADMIN_EMAIL": "admin@jovicgroup.com",
    "RESEND_FROM_EMAIL": "noreply@jovicgroup.com",
    "NEXT_PUBLIC_SITE_URL": "https://jovicgroup.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jovicgroup"
    }
  ]
}